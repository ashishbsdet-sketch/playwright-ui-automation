{
  "name": "playwright-ui-tests",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "playwright test --project=chromium --workers=1",
    "test:headed": "playwright test --headed --workers=1",
    "report": "playwright show-report",
    "report:enhanced": "node scripts/generate-enhanced-report.js",
    "mcp:start": "node mcp-server/index.js",
    "mcp:start:heal": "MCP_ALLOW_HEAL=true npm run mcp:start"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
